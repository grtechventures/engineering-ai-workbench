# Build on an approved provisioning machine, then pin the resulting local image ID.
FROM python:3.12-slim
RUN pip install --no-cache-dir numpy==2.2.6 matplotlib==3.10.3 openpyxl==3.1.5 defusedxml==0.7.1 python-docx==1.2.0 pypdf==6.0.0
COPY docker/workbench_files.py /usr/local/lib/python3.12/site-packages/workbench_files.py
ENV MPLBACKEND=Agg MPLCONFIGDIR=/tmp/mpl
USER 65534:65534
