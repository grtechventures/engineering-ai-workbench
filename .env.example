# Set these in the server process environment. This file is not auto-loaded.
# Ollama example; select a model you have already installed.
# EWB_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
# EWB_LOCAL_MODEL=qwen3:8b
# Non-loopback engineering model hosts require explicit administrative approval.
# EWB_APPROVED_ONPREM=1
# EWB_LOCAL_API_KEY=
# Optional LAN model: exact private literal IPs only, comma separated.
# EWB_APPROVED_MODEL_IPS=10.1.2.3
# Internet inference is disabled; frontier settings do not override the policy.
# Exact local Docker image ID, obtained after pulling/building a reviewed Python image.
# EWB_WORKER_IMAGE=sha256:...
# Local disk only: never use a network share or cloud-synchronized database folder.
# EWB_DATA_DIR=C:\Workbench\state
# Evidence-only destination; can be an administrator-mounted file share.
# EWB_ARTIFACT_DIR=C:\Workbench\evidence

# External evidence destinations also require an exact approved root.
# EWB_APPROVED_FILE_ROOTS=C:\Workbench\evidence
